{
  "name": "code-davinci",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:worker": "wrangler dev --local --port 8787",
    "dev:tunnel": "ssh -N -T -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 80:127.0.0.1:8787 localhost.run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx scripts/seed.ts",
    "webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "drizzle-orm": "0.45.1",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "drizzle-kit": "0.31.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.122.0"
  }
}
